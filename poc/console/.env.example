# Server-only development settings. Copy values into .env; never use VITE_ prefixes here.
NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173

# Google Cloud server settings. Authentication uses ADC, never an API key.
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=asia-northeast1

# Hedera server-only settings.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
MIRROR_URL=https://testnet.mirrornode.hedera.com

# World ID server-only settings.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=

SEAL_DELAY_SECONDS=0
X402_PORT=8081
X402_PRICE_TINYBAR=0
