# Firebase web config is public application metadata, not authorization.
# Restrict the key to the Firebase APIs and authorized origins used by this app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Browser-visible API base URL. Leave empty locally to use the Vite proxy.
VITE_API_BASE_URL=
