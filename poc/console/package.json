{
  "name": "oshikatsu-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @oshikatsu/web",
    "dev:api": "npm run dev --workspace @oshikatsu/api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "check:hcs-envelope": "node scripts/check-hcs-envelope-budget.mjs",
    "spike:hcs-boundary": "node scripts/hcs-boundary-spike.mjs",
    "acceptance:production": "node scripts/acceptance-production.mjs",
    "security:check": "node scripts/check-ai-boundary.mjs",
    "test": "npm run test --workspaces --if-present"
  }
}
